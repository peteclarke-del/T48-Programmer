#!/bin/sh

# Avoid loading private GTK modules inherited from a Snap-packaged editor.
case "${GTK_PATH:-}:${GTK_EXE_PREFIX:-}" in
    *:/snap/*|/snap/*:*)
        unset GTK_PATH GTK_EXE_PREFIX GTK_IM_MODULE_FILE
        unset GDK_PIXBUF_MODULE_FILE GDK_PIXBUF_MODULEDIR
        unset GIO_MODULE_DIR GSETTINGS_SCHEMA_DIR LOCPATH
        unset XDG_DATA_HOME XDG_DATA_DIRS
        ;;
esac

application_lib=/usr/lib/t48-programmer
export PYTHONPATH="${application_lib}${PYTHONPATH:+:${PYTHONPATH}}"
# The bundled minipro comes first, so the version the package was tested with
# is the one that runs. T48_PROGRAMMER_MINIPRO still overrides it.
export PATH="${application_lib}/bin:${PATH}"

exec /usr/bin/python3 -m t48_programmer "$@"
